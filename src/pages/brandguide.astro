---
// Brandguide. Ikke linket fra menuen og ikke indekseret.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Side from '../components/Side.astro';
import parcelhus from '../assets/boliger/parcelhus.jpg';
import raekkehuse from '../assets/boliger/raekkehuse.jpg';
import etageejendom from '../assets/boliger/etageejendom.jpg';

const hoved = [
  { navn: 'Skovgrøn', token: '--gron', hex: '#1F3D33', rolle: 'Hovedfarve fra logoet. Knapper, links, statuslinje, estimatet og sidefoden.', kontrast: '11,8:1 på hvid' },
  { navn: 'Skovgrøn mørk', token: '--gron-moerk', hex: '#172E26', rolle: 'Hover og aktive knapper.', kontrast: '14,4:1 på hvid' },
  { navn: 'Grøn tone', token: '--gron-tone', hex: '#E8EFEA', rolle: 'Valgte felter, resultatbokse, statuslinjens bund.', kontrast: 'Skovgrøn på tone 10,1:1' },
  { navn: 'Grøn kant', token: '--gron-kant', hex: '#C3D3CA', rolle: 'Fokusring og kant om valgt mægler.', kontrast: 'Kun dekoration' },
  { navn: 'Rav', token: '--rav', hex: '#E3A54A', rolle: 'CTA-knapper med mørk tekst. Fluebenet i logoet. Aldrig som tekstfarve på lys baggrund.', kontrast: 'Skifer på rav 7,8:1. Rav på kalk 2,0:1' },
];
const neutrale = [
  { navn: 'Kalk', token: '--kalk', hex: '#F6F4EF', rolle: 'Sidens baggrund. Samme lyse farve som i logoet.', kontrast: '' },
  { navn: 'Hvid', token: '--flade', hex: '#FFFFFF', rolle: 'Kort, formular og felter.', kontrast: '' },
  { navn: 'Skifer', token: '--blaek', hex: '#1A1F1C', rolle: 'Brødtekst og overskrifter.', kontrast: '15,2:1 på kalk' },
  { navn: 'Skifer lys', token: '--skifer', hex: '#56605B', rolle: 'Sekundær tekst og hjælpetekst.', kontrast: '5,9:1 på kalk' },
  { navn: 'Feltkant', token: '--felt-kant', hex: '#7E8A84', rolle: 'Kant om inputfelter.', kontrast: '3,6:1 på hvid' },
  { navn: 'Streg', token: '--streg', hex: '#DFE3DE', rolle: 'Skillelinjer og kortkanter.', kontrast: 'Kun dekoration' },
];
const funktion = [
  { navn: 'Grøn', token: '--ok', hex: '#1E7A4C', rolle: 'Flueben i lister. Kun som tegn på "i orden".', kontrast: '5,3:1 på hvid' },
  { navn: 'Rød', token: '--fejl', hex: '#B3261E', rolle: 'Fejlbeskeder i formularen. Aldrig til knapper.', kontrast: '6,5:1 på hvid' },
  { navn: 'Pladsholder', token: '--ph-bg', hex: '#FFF3C4', rolle: 'Kun under udvikling. Markerer tekst og tal, der skal skiftes ud.', kontrast: '' },
];
const marked = [
  { hvem: 'home', farve: '#E52332', note: 'Rød' },
  { hvem: 'danbolig', farve: '#006664', note: 'Petrol og mørk grøn' },
  { hvem: 'nybolig', farve: '#122D3A', note: 'Mørk navy med grøn' },
  { hvem: 'EDC', farve: '#0E4374', note: 'Blå med gul' },
  { hvem: 'Estate', farve: '#445E8D', note: 'Blå' },
  { hvem: 'RealMæglerne', farve: '#003761', note: 'Navy med orange' },
  { hvem: 'LokalBolig', farve: '#678D72', note: 'Salviegrøn' },
  { hvem: 'Nem Vurdering', farve: '#1F3D33', note: 'Skovgrøn med rav' },
];
---
<Base titel="Brandguide | Nem Vurdering" beskrivelse="Nem Vurderings farver, typografi, logo og billedstil." noindex>
  <Side titel="Nem Vurdering i farver, skrift og billeder" lead="Logoets skovgrønne som hovedfarve, lyse neutraler og almindelige danske boliger. Alt her er bygget ind i siden som variabler, så en ændring her slår igennem overalt." />

  <section class="sektion" style="padding-top:1rem">
    <div class="wrap stak-l">
      <div class="prosa">
        <h2>Om farverne</h2>
        <p>Farverne kommer fra logoet: en dyb skovgrøn, en lys kalkfarve og et ravfarvet flueben. Rav bruges til de knapper, man skal trykke på. Skovgrøn bruges til links, valg, statuslinje og sidefod.</p>
        <p>Vi har kigget på de farver, de største mæglerkæder bruger. De ligger i to grupper: rød (home) eller blå, navy og grøn (danbolig, nybolig, EDC, Estate, RealMæglerne og LokalBolig).</p>
        <p><strong>Risikoen</strong> er, at skovgrøn ligger tæt på danbolig, nybolig og LokalBolig. Nem Vurdering samarbejder med mæglere fra flere kæder, så siden må ikke ligne én af dem. Det gyldne flueben og den lyse kalkfarve er det, der skiller os ud. Brug dem konsekvent, også i annoncer.</p>
      </div>

      <div class="marked" role="list" aria-label="Farver hos mæglerkæderne">
        {marked.map((m) => (
          <div class="marked-felt" role="listitem">
            <span class="marked-farve" style={`background:${m.farve}`}></span>
            <strong>{m.hvem}</strong>
            <span class="marked-note">{m.note}</span>
          </div>
        ))}
      </div>
      <p class="hjaelp">Kilde: de mest brugte farver i kædernes egne stylesheets og meta-tags, hentet 18. oktober 2026. Ikke kædernes officielle brandguides.</p>
    </div>
  </section>

  {[{ t: 'Hovedfarve', l: hoved }, { t: 'Neutrale farver', l: neutrale }, { t: 'Funktionsfarver', l: funktion }].map((g) => (
    <section class="sektion sektion--tone farve-sektion">
      <div class="wrap stak-l">
        <h2>{g.t}</h2>
        <div class="farver">
          {g.l.map((f) => (
            <article class="farve kort">
              <div class="farve-proeve" style={`background:${f.hex}`}></div>
              <div class="farve-tekst">
                <h3>{f.navn}</h3>
                <p class="farve-hex tal">{f.hex}</p>
                <p class="farve-token"><code>var({f.token})</code></p>
                <p>{f.rolle}</p>
                {f.kontrast && <p class="hjaelp">Kontrast: {f.kontrast}</p>}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="sektion">
    <div class="wrap stak-l">
      <h2>Regler for farverne</h2>
      <ul class="regler prosa">
        <li>Skovgrøn bruges til links, valg og estimatet. Den må gerne fylde i sidefoden, men ikke i store flader midt på siden.</li>
        <li>Der er én primær knap pr. skærm. Den er rav med mørk tekst.</li>
        <li>Rød bruges kun til fejl. Aldrig til knapper, tilbud eller fremhævning.</li>
        <li>Al tekst har mindst 4,5:1 i kontrast. Feltkanter mindst 3:1.</li>
        <li>Siden har også et mørkt tema. Farverne skifter automatisk efter telefonens indstilling.</li>
      </ul>
    </div>
  </section>

  <section class="sektion sektion--tone">
    <div class="wrap stak-l">
      <h2>Skrift</h2>
      <div class="skrift">
        <p class="skrift-stor">Hvad er din bolig værd i dag?</p>
        <p class="skrift-mellem">Få et gratis estimat på 30 sekunder.</p>
        <p class="skrift-tal tal">3.450.000 til 4.200.000 kr.</p>
        <p>Plus Jakarta Sans, én variabel fil med vægt 200 til 800 og font-display: swap. Den er venlig og let at læse på små skærme. Den hostes på vores egen server, så vi ikke sender besøgendes IP-adresse til Google.</p>
        <ul class="regler">
          <li>Overskrifter: vægt 700 til 750, let negativ spærring.</li>
          <li>Brødtekst: vægt 400, 17 px på mobil, linjehøjde 1,55.</li>
          <li>Tal i beløb og nøgletal: tabeltal, så cifrene står lige.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="sektion">
    <div class="wrap stak-l">
      <h2>Logo</h2>
      <div class="logoer">
        <div class="logo-proeve logo-lys"><img src="/brand/logo.svg" alt="Nem Vurdering" /></div>
        <div class="logo-proeve logo-moerk"><img src="/brand/logo-hvid.svg" alt="Nem Vurdering, hvid udgave" /></div>
        <div class="logo-proeve logo-lys"><img class="logo-ikon" src="/brand/ikon.svg" alt="Ikon" /></div>
      </div>
      <ul class="regler prosa">
        <li><code>logo.svg</code> på lys baggrund. <code>logo-hvid.svg</code> på skovgrøn eller mørk baggrund.</li>
        <li><code>ikon.svg</code> alene, fx som profilbillede. Favicon og app-ikon ligger i <code>/brand/</code>.</li>
        <li>Navnet skrives "Nem Vurdering" i løbende tekst.</li>
      </ul>
    </div>
  </section>

  <section class="sektion sektion--tone">
    <div class="wrap stak-l">
      <h2>Billeder</h2>
      <div class="billeder">
        {[{ b: parcelhus, alt: 'Parcelhus i røde mursten' }, { b: raekkehuse, alt: 'Gule rækkehuse med forhaver' }, { b: etageejendom, alt: 'Muret etageejendom med altaner' }].map(({ b, alt }) => (
          <Image src={b} alt={alt} widths={[400, 700]} sizes="(min-width: 48rem) 33vw, 100vw" quality={70} loading="lazy" />
        ))}
      </div>
      <div class="prosa">
        <ul class="regler">
          <li>Almindelige danske boliger: parcelhuse i røde mursten, rækkehuse, etageejendomme. Dagslys, gerne overskyet.</li>
          <li>Rigtige mennesker: mæglerne, fotograferet hvor de arbejder. Aldrig håndtryk, nøgleoverrækkelser eller smilende par med papkasser.</li>
          <li>Ingen filtre og ingen kraftig efterbehandling.</li>
        </ul>
        <p><strong>Om de nuværende billeder:</strong> De tre boligbilleder er genereret med AI (Higgsfield) som midlertidige billeder. De viser ingen rigtige adresser. De bør skiftes til egne fotos før lancering, og der er bevidst ingen AI-genererede mennesker på siden.</p>
      </div>
    </div>
  </section>

  <section class="sektion">
    <div class="wrap prosa">
      <h2>Tone</h2>
      <ul class="regler">
        <li>Talt dansk. Korte sætninger. Du-form.</li>
        <li>Ingen tankestreger. Brug punktum eller komma.</li>
        <li>Ingen superlativer, ingen ord der lover uafhængighed, og ingen løfter om lavere salær.</li>
        <li>Tal som en autoritet med en mission: rolig, sikker og konkret. Vis, hvad boligejeren får, ikke hvordan vi tjener penge.</li>
        <li>Sig altid, at vi anbefaler blandt udvalgte partnermæglere. Det er et lovkrav, ikke en salgstekst.</li>
        <li>Tal har altid en kilde ved siden af.</li>
      </ul>
    </div>
  </section>
</Base>
<style>
  .marked {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
    gap: 0.75rem;
  }
  .marked-felt {
    display: grid;
    gap: 0.25rem;
    font-size: var(--t-s);
  }
  .marked-farve {
    height: 3.5rem;
    border-radius: var(--r-s);
    border: 1px solid var(--streg);
  }
  .marked-note {
    color: var(--skifer);
  }
  .farve-sektion + .farve-sektion {
    border-top: 0;
    padding-top: 0;
  }
  .farver {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: 1rem;
  }
  .farve {
    overflow: hidden;
  }
  .farve-proeve {
    height: 6rem;
    border-bottom: 1px solid var(--streg);
  }
  .farve-tekst {
    padding: 1rem;
    display: grid;
    gap: 0.3rem;
    font-size: var(--t-s);
  }
  .farve-tekst h3 {
    font-size: var(--t-m);
  }
  .farve-hex {
    font-weight: 700;
    font-size: var(--t-m);
  }
  .farve-token code {
    font-size: var(--t-xs);
    color: var(--skifer);
  }
  .regler {
    margin: 0;
    padding-left: 1.25rem;
    display: grid;
    gap: 0.4rem;
  }
  .skrift {
    display: grid;
    gap: 1rem;
    max-width: 44rem;
  }
  .skrift-stor {
    font-size: var(--t-xxl);
    font-weight: 750;
    letter-spacing: -0.015em;
    line-height: 1.1;
  }
  .skrift-mellem {
    font-size: var(--t-l);
    color: var(--skifer);
  }
  .skrift-tal {
    font-size: var(--t-xl);
    font-weight: 750;
    color: var(--gron);
  }
  .logoer {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1rem;
  }
  .logo-proeve {
    display: grid;
    place-items: center;
    min-height: 8rem;
    border-radius: var(--r-m);
    border: 1px solid var(--streg);
  }
  .logo-lys {
    background: #f6f4ef;
  }
  .logo-moerk {
    background: #1f3d33;
  }
  .logo-proeve img {
    height: 40px;
    width: auto;
  }
  .logo-proeve .logo-ikon {
    height: 56px;
  }
  .billeder {
    display: grid;
    gap: 0.75rem;
  }
  .billeder img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--r-m);
  }
  @media (min-width: 48rem) {
    .billeder {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
