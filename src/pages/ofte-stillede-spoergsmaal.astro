---
import Base from '../layouts/Base.astro';
import Side from '../components/Side.astro';
import Faq from '../components/Faq.astro';
import Ph from '../components/Ph.astro';
import site from '../data/site.json';
---
<Base titel="Ofte stillede spørgsmål | Nem Vurdering" beskrivelse="Svar på de spørgsmål, vi oftest får om Nem Vurdering: pris, mæglere, estimatet og dine oplysninger.">
  <Side eyebrow="Spørgsmål" titel="Ofte stillede spørgsmål" lead="Finder du ikke dit svar her, er du velkommen til at skrive til os." />
  <section class="sektion" style="padding-top:1rem">
    <div class="wrap stak-l">
      <Faq />
      <p>Skriv til <Ph v={site.email} /></p>
    </div>
  </section>
</Base>
