---
import Base from '../layouts/Base.astro';
import Side from '../components/Side.astro';
import Faq from '../components/Faq.astro';
import Ph from '../components/Ph.astro';
import site from '../../data/site.json';
---
<Base titel="Ofte stillede spørgsmål | Nem Vurdering" beskrivelse="Svar på det, vi oftest bliver spurgt om: hvor præcist estimatet er, hvem der får dine oplysninger, hvordan vi finder din mægler, og hvordan vi tjener penge.">
  <Side titel="Ofte stillede spørgsmål" lead="Finder du ikke dit svar her, er du velkommen til at skrive til os." />
  <section class="sektion" style="padding-top:1rem">
    <div class="wrap stak-l">
      <Faq />
      <p>Skriv til <Ph v={site.email} /></p>
    </div>
  </section>
</Base>
