---
import Base from '../layouts/Base.astro';
import Side from '../components/Side.astro';
import Ph from '../components/Ph.astro';
import site from '../data/site.json';
---
<Base titel="Hvem står bag Nem Vurdering" beskrivelse="Nem Vurdering drives af Hero Media ApS. Her kan du se, hvem vi er, og hvordan du får fat i os.">
  <Side eyebrow="Hvem står bag" titel="Nem Vurdering drives af Hero Media ApS" lead="Vi er et dansk firma. Vi står ved, hvem vi er, hvordan vi tjener penge, og hvordan du får fat i os." />

  <section class="sektion" style="padding-top:1rem">
    <div class="wrap team">
      {site.team.map((p) => (
        <article class="person kort">
          {p.billede ? (
            <img src={p.billede} alt={`Portræt af ${p.navn}`} width="320" height="320" loading="lazy" decoding="async" />
          ) : (
            <div class="ph-boks person-foto">[PLADSHOLDER: rigtigt portræt, ikke stockfoto]</div>
          )}
          <div class="stak person-tekst">
            <h2 class="person-navn"><Ph v={p.navn} /></h2>
            <p class="eyebrow"><Ph v={p.rolle} /></p>
            <p><Ph v={p.tekst} /></p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="sektion sektion--tone">
    <div class="wrap stak-l">
      <h2>Firmaoplysninger</h2>
      <dl class="fakta">
        <div><dt>Selskab</dt><dd>{site.selskab}</dd></div>
        <div><dt>CVR</dt><dd><Ph v={site.cvr} /></dd></div>
        <div><dt>Adresse</dt><dd><Ph v={site.adresse} />, <Ph v={site.postnrBy} /></dd></div>
        <div><dt>Telefon</dt><dd><Ph v={site.telefon} /></dd></div>
        <div><dt>E-mail</dt><dd><Ph v={site.email} /></dd></div>
      </dl>
      <p class="prosa">Hero Media ApS er et marketingbureau. Nem Vurdering er vores egen tjeneste. Vi tjener penge ved, at ejendomsmæglere betaler os, når de får en henvendelse gennem Nem Vurdering. Læs mere på <a href={site.heroMediaUrl} target="_blank" rel="noopener">heromedia.dk</a>.</p>
    </div>
  </section>
</Base>
<style>
  .team { display: grid; gap: 1rem; }
  @media (min-width: 48rem) { .team { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .person { overflow: hidden; display: grid; }
  .person img, .person-foto { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 0; border-width: 0 0 2px; }
  .person-tekst { padding: 1.25rem; gap: 0.5rem; }
  .person-navn { font-size: var(--t-l); }
  .fakta { margin: 0; display: grid; border-top: 1px solid var(--streg); max-width: 40rem; }
  .fakta div { display: grid; grid-template-columns: 7rem 1fr; gap: 1rem; padding-block: 0.85rem; border-bottom: 1px solid var(--streg); }
  .fakta dt { font-weight: 650; }
  .fakta dd { margin: 0; min-width: 0; overflow-wrap: anywhere; }
</style>
