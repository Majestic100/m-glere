---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Forskel from '../components/Forskel.astro';
import SaadanMatcher from '../components/SaadanMatcher.astro';
import SaadanVirkerDet from '../components/SaadanVirkerDet.astro';
import KunEn from '../components/KunEn.astro';
import Marked from '../components/Marked.astro';
import Penge from '../components/Penge.astro';
import Anmeldelser from '../components/Anmeldelser.astro';
import Faq from '../components/Faq.astro';
import SlutCta from '../components/SlutCta.astro';
---
<Base
  titel="Hvad er din bolig værd? Gratis estimat | Nem Vurdering"
  beskrivelse="Se et gratis estimat på din bolig på 30 sekunder. Vi finder den lokale mægler, der passer bedst til din bolig, og kun den mægler kontakter dig. Uden binding."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Nem Vurdering',
    url: new URL('/', Astro.site).toString(),
    logo: new URL('/brand/ikon-512.png', Astro.site).toString(),
  })} />
  <Hero billede={false} eksempel />

  <Forskel />

  <SaadanMatcher />

  <section class="sektion" aria-labelledby="svd-titel">
    <div class="wrap stak-l">
      <h2 id="svd-titel">Sådan foregår det</h2>
      <SaadanVirkerDet />
    </div>
  </section>

  <KunEn />

  <Marked />

  <section class="sektion" aria-label="Sådan tjener vi penge">
    <div class="wrap"><Penge /></div>
  </section>

  <Anmeldelser />

  <section class="sektion sektion--tone" aria-labelledby="faq-titel">
    <div class="wrap stak-l">
      <h2 id="faq-titel">Ofte stillede spørgsmål</h2>
      <Faq antal={6} />
      <p><a href="/ofte-stillede-spoergsmaal">Se alle spørgsmål</a></p>
    </div>
  </section>

  <SlutCta />
</Base>
