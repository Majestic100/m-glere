---
import Base from '../layouts/Base.astro';
import Side from '../components/Side.astro';
import Ph from '../components/Ph.astro';
import site from '../data/site.json';
---
<Base titel="For ejendomsmæglere | Nem Vurdering" beskrivelse="Bliv partnermægler hos Nem Vurdering og få henvendelser fra boligejere, der selv har valgt dig.">
  <Side titel="Få henvendelser fra boligejere, der selv har valgt dig" lead="Boligejeren ser dit billede, din video og dine tal, og vælger dig. Henvendelsen går kun til dig." />
  <section class="sektion" style="padding-top:1rem">
    <div class="wrap prosa">
      <ul>
        <li>Du betaler pr. henvendelse. <Ph v="[PLADSHOLDER: pris og vilkår, eller 'kontakt os for pris']" /></li>
        <li>Vi ringer boligejeren op først og bekræfter oplysningerne, før henvendelsen går videre til dig.</li>
        <li>Du får adresse, boligtype, areal, tidshorisont, prioriteter og bedste tidspunkt at ringe.</li>
        <li>Du kan selv opdatere dit billede, din video og dine postnumre sammen med os.</li>
      </ul>
      <p>Vil du høre mere? Skriv til <Ph v={site.email} />.</p>
    </div>
  </section>
</Base>
