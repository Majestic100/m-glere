---
import Base from '../layouts/Base.astro';
import Side from '../components/Side.astro';
import Ph from '../components/Ph.astro';
import site from '../../data/site.json';
const b2b = site.b2bUrl && !site.b2bUrl.startsWith('TODO_DATA') ? site.b2bUrl : null;
---
<Base titel="For ejendomsmæglere | Nem Vurdering" beskrivelse="Bliv partnermægler hos Nem Vurdering og få henvisninger fra boligejere i dit område, som har bekræftet, at de vil kontaktes.">
  <Side titel="Er du ejendomsmægler?" lead="Vi matcher boligejere med én lokal partnermægler. Henvisningen går kun til dig, og først når boligejeren har bekræftet." />
  <section class="sektion" style="padding-top:1rem">
    <div class="wrap prosa">
      <ul>
        <li>Du får adresse, boligtype, areal, stand, tilvalg, salgshorisont og estimat med hver henvisning.</li>
        <li>Vi ringer eller skriver til boligejeren først og bekræfter henvendelsen.</li>
        <li>Matchingen bygger på lokale salg, liggetid, prisniveau, feedback og responstid. Du styrer selv dine postnumre, boligtyper og hvor mange henvisninger du vil have.</li>
        <li>Pris og vilkår: <Ph v="TODO_DATA" /></li>
      </ul>
      {b2b ? <p><a class="knap" href={b2b}>Læs mere og kom i gang</a></p> : <p>Skriv til <Ph v={site.email} />.</p>}
    </div>
  </section>
</Base>
