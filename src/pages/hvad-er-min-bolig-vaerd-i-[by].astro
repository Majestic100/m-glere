---
// Skabelon til bysider. Én side pr. fil i src/content/byer.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SaadanVirkerDet from '../components/SaadanVirkerDet.astro';
import Penge from '../components/Penge.astro';
import Faq from '../components/Faq.astro';
import Ph from '../components/Ph.astro';

export async function getStaticPaths() {
  const byer = await getCollection('byer');
  return byer.map((b) => ({ params: { by: b.data.slug }, props: { b: b.data } }));
}
const { b } = Astro.props;
const kr = (n: number) => `${new Intl.NumberFormat('da-DK').format(n)} kr.`;
---
<Base
  titel={`Hvad er min bolig værd i ${b.by}? | Nem Vurdering`}
  beskrivelse={`Få et gratis estimat på din bolig i ${b.by} på 30 sekunder, og vælg selv den lokale mægler, der kender dit område.`}
>
  <Hero by={b.by} billede={b.billede} />

  <section class="sektion sektion--tone" aria-labelledby="pris-titel">
    <div class="wrap prosa">
      <p class="eyebrow">Boligpriser i {b.by}</p>
      <h2 id="pris-titel">Sådan har priserne udviklet sig i {b.by}</h2>
      {b.intro && <p>{b.intro}</p>}
      <p><Ph v={b.prisudvikling.tekst} /></p>
      {b.prisudvikling.punkter.length > 0 && (
        <table class="pris-tabel">
          <caption class="sr-only">Gennemsnitlig kvadratmeterpris i {b.by}</caption>
          <thead><tr><th scope="col">Periode</th><th scope="col">Kr. pr. m²</th></tr></thead>
          <tbody>
            {b.prisudvikling.punkter.map((p) => (
              <tr><td>{p.periode}</td><td class="tal">{kr(p.kvmpris)}</td></tr>
            ))}
          </tbody>
        </table>
      )}
      <p class="hjaelp">Kilde: <Ph v={b.prisudvikling.kilde} /></p>
    </div>
  </section>

  <section class="sektion" aria-labelledby="svd-titel">
    <div class="wrap stak-l">
      <h2 id="svd-titel">Sådan virker det</h2>
      <SaadanVirkerDet />
    </div>
  </section>

  <section class="sektion sektion--tone" aria-label="Sådan tjener vi penge">
    <div class="wrap"><Penge /></div>
  </section>

  <section class="sektion" aria-labelledby="faq-titel">
    <div class="wrap stak-l">
      <h2 id="faq-titel">Ofte stillede spørgsmål</h2>
      <Faq antal={4} />
      <p><a href="/ofte-stillede-spoergsmaal">Se alle spørgsmål</a></p>
    </div>
  </section>
</Base>
<style>
  .pris-tabel {
    border-collapse: collapse;
    width: 100%;
    max-width: 28rem;
  }
  .pris-tabel th,
  .pris-tabel td {
    text-align: left;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--streg);
  }
  .pris-tabel td:last-child,
  .pris-tabel th:last-child {
    text-align: right;
  }
</style>
