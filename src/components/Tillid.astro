---
const punkter = ['Gratis for dig.', 'Kun den mægler du vælger, kontakter dig.', 'Ingen binding.'];
---
<ul class="tillid">
  {punkter.map((p) => (
    <li>
      <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true"><rect class="tillid-bund" width="22" height="22" rx="6"></rect><path class="tillid-flueben" d="m6.5 11.4 3 3 6-6.6" fill="none" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      <span>{p}</span>
    </li>
  ))}
</ul>
