---
const punkter = ['Gratis for dig.', 'Kun den mægler du vælger, kontakter dig.', 'Ingen binding.'];
---
<ul class="tillid">
  {punkter.map((p) => (
    <li>
      <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="10" fill="currentColor" opacity="0.14"></circle><path d="m5.8 10.3 2.7 2.7 5.7-6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      <span>{p}</span>
    </li>
  ))}
</ul>
