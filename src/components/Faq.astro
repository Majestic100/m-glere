---
import { faq } from '../data/faq.js';
import site from '../../data/site.json';
interface Props { antal?: number; ekstra?: { id: string; q: string; a: string[] }[] }
const { antal, ekstra = [] } = Astro.props;
const alle = [...ekstra, ...faq];
const liste = antal ? alle.slice(0, antal) : alle;
const erPh = (t: string) => t.includes('TODO_DATA') || t.trim().startsWith('[');
// Kontakt-e-mail sættes ind, når den er udfyldt i data/site.json.
const udfyld = (t: string) => (site.email && !site.email.startsWith('TODO_DATA') ? t.replace('TODO_DATA', site.email) : t);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: liste
    .map((f) => ({ ...f, a: f.a.map(udfyld) }))
    .filter((f) => !f.a.some(erPh))
    .map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a.join(' ') } })),
};
---
<div class="faq">
  {liste.map((f) => (
    <details id={f.id}>
      <summary>{f.q}</summary>
      <div class="svar">{f.a.map(udfyld).map((p) => (erPh(p) ? <p><mark class="ph">{p}</mark></p> : <p>{p}</p>))}</div>
    </details>
  ))}
</div>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<script>
  // Åbn spørgsmålet, hvis der linkes direkte til det.
  const id = location.hash.slice(1);
  const el = id ? document.getElementById(id) : null;
  if (el instanceof HTMLDetailsElement) el.open = true;
</script>
