---
import site from '../data/site.json';
---
<div class="stak anm">
  <p class="eyebrow">Anmeldelser</p>
  <h2>Hvad siger andre boligejere?</h2>
  {site.trustpilotUrl ? (
    <p><a href={site.trustpilotUrl} target="_blank" rel="noopener">Se vores anmeldelser på Trustpilot</a></p>
  ) : (
    <div class="ph-boks">
      [PLADSHOLDER: Trustpilot-widget. Indsættes, når Vurdo har rigtige anmeldelser. Vi skriver ingen anmeldelser selv.]
    </div>
  )}
</div>
<style>
  .anm .ph-boks {
    min-height: 9rem;
  }
</style>
