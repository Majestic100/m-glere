---
import Ph from './Ph.astro';
interface Props { m: Record<string, any> }
const { m } = Astro.props;
const harTal = (v: unknown) => v !== null && v !== undefined && v !== '';
const bedoemmelse = harTal(m.bedoemmelse) ? `${String(m.bedoemmelse).replace('.', ',')} af 5` : null;
---
<article class="mk">
  <div class="mk-hoved">
    {m.billede ? (
      <img class="mk-foto" src={m.billede} alt={`Portræt af ${m.navn}`} width="72" height="72" loading="lazy" decoding="async" />
    ) : (
      <div class="mk-foto mk-foto--ph" role="img" aria-label="Billede mangler">Foto af mægler</div>
    )}
    <div>
      <h3 class="mk-navn"><Ph v={m.navn} /></h3>
      <p class="mk-titel">{m.titel}</p>
      <p class="mk-butik"><Ph v={m.butik} /></p>
    </div>
  </div>
  <p class="mk-omraade">Dækker {m.omraade}</p>
  {m.video ? (
    <button type="button" class="mk-video" data-video={m.video} style={m.videoPoster ? `background-image:url(${m.videoPoster})` : undefined}>
      <span><svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2.5v11l9-5.5z" fill="currentColor"></path></svg>Se video med {m.navn}</span>
    </button>
  ) : (
    <div class="mk-video mk-video--ph">[PLADSHOLDER: kort video, 30 til 60 sek.]</div>
  )}
  <dl class="mk-tal">
    <div>
      <dt>Solgte i området</dt>
      <dd>{harTal(m.solgte) ? m.solgte : <mark class="ph">[tal]</mark>}<span class="mk-kilde">{m.solgtePeriode}, <Ph v={m.solgteKilde} /></span></dd>
    </div>
    <div>
      <dt>Bedømmelse</dt>
      <dd>{bedoemmelse ?? <mark class="ph">[tal]</mark>}<span class="mk-kilde">{harTal(m.bedoemmelseAntal) ? `${m.bedoemmelseAntal} anmeldelser, ` : ''}<Ph v={m.bedoemmelseKilde} /></span></dd>
    </div>
  </dl>
  <p class="mk-beskrivelse"><Ph v={m.beskrivelse} /></p>
  <slot />
</article>
