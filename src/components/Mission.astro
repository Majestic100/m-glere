---
// Hvorfor Nem Vurdering findes. Ambition uden påstande, vi ikke kan dokumentere.
const saeler = [
  { t: 'Overblik fra start', b: 'Du ved, hvad din bolig er værd, før du taler med nogen.' },
  { t: 'Ét klart match', b: 'Ingen lange lister. Én anbefaling med en begrundelse.' },
  { t: 'Du bestemmer', b: 'Du vælger selv, om og hvornår mægleren må kontakte dig.' },
];
---
<section class="sektion mission" aria-labelledby="mission-titel">
  <div class="wrap mission-indhold">
    <h2 id="mission-titel">Boligsalg er en af de største handler, du laver. Valget af mægler skal bygge på mere end et tilfældigt opkald.</h2>
    <p class="lead">Nem Vurdering er skabt for at ændre måden, boligejere og mæglere finder hinanden på. Vi giver dig et klart billede af, hvad din bolig er værd, og forbinder dig med den lokale mægler, der passer til netop din bolig. Du får et stærkere udgangspunkt for dit salg, og mægleren møder en boligejer, der er klar til en god snak.</p>
    <ul class="mission-saeler">
      {saeler.map((x) => (
        <li><strong>{x.t}</strong><span>{x.b}</span></li>
      ))}
    </ul>
  </div>
</section>
<style>
  .mission-indhold {
    display: grid;
    gap: 1.5rem;
  }
  .mission h2 {
    font-size: clamp(1.75rem, 1.2rem + 2.2vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.12;
    color: var(--gron);
    max-width: 22em;
  }
  .mission .lead {
    max-width: 42rem;
  }
  .mission-saeler {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
  }
  .mission-saeler li {
    display: grid;
    gap: 0.25rem;
    padding-top: 1rem;
    border-top: 3px solid var(--rav);
  }
  .mission-saeler span {
    color: var(--skifer);
  }
  @media (min-width: 48rem) {
    .mission-saeler {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
  }
</style>
