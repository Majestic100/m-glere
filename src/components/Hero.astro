---
import { Image } from 'astro:assets';
import Vurdering from './Vurdering.astro';
import Tillid from './Tillid.astro';
import Aktivitet from './Aktivitet.astro';
import ResultatEksempel from './ResultatEksempel.astro';
import parcelhus from '../assets/boliger/parcelhus.jpg';
import raekkehuse from '../assets/boliger/raekkehuse.jpg';
import etageejendom from '../assets/boliger/etageejendom.jpg';
import aarhusGade from '../assets/boliger/aarhus-gade.jpg';

interface Props { titel?: string; undertitel?: string; billede?: string | false; eksempel?: boolean }
const {
  titel = 'Hvad er din bolig værd? Se et estimat på 30 sekunder',
  undertitel = 'Gratis og uforpligtende. Vi finder den lokale mægler, der passer bedst til din bolig, og kun den mægler kontakter dig.',
  billede = 'parcelhus',
  eksempel = false,
} = Astro.props;
const billeder = { parcelhus, raekkehuse, etageejendom, 'aarhus-gade': aarhusGade } as const;
const alt = {
  parcelhus: 'Rødt murstenshus med have og cykel i indkørslen',
  raekkehuse: 'Række af gule rækkehuse med små forhaver',
  etageejendom: 'Muret etageejendom med altaner og cykler foran',
  'aarhus-gade': 'Villavej i Aarhus med gule og røde byhuse',
} as const;
const valgt = billede ? (billeder[billede as keyof typeof billeder] ?? parcelhus) : null;
---
<section class="hero">
  <div class:list={['wrap hero-gitter', { 'hero-gitter--eksempel': eksempel }]}>
    <div class="hero-tekst stak">
      <h1>{titel.includes('? ') ? <><span class="h1-del">{titel.split('? ')[0]}?</span> {titel.split('? ').slice(1).join('? ')}</> : titel}</h1>
      <p class="lead">{undertitel}</p>
    </div>
    <div class="hero-form">
      <Vurdering />
    </div>
    <div class="hero-tillid">
      <Tillid />
      <Aktivitet />
    </div>
    {eksempel && (
      <div class="hero-eksempel"><ResultatEksempel /></div>
    )}
    {valgt && (
      <figure class="hero-foto">
        <Image src={valgt} alt={alt[billede as keyof typeof alt] ?? alt.parcelhus} widths={[480, 800, 1200]} sizes="(min-width: 60rem) 30rem, 100vw" quality={70} loading="lazy" decoding="async" />
        <figcaption>Midlertidigt billede. <mark class="ph">TODO_DATA: skiftes til eget foto</mark></figcaption>
      </figure>
    )}
  </div>
</section>
<style>
  .hero {
    padding-block: 1.5rem 3rem;
  }
  .hero-gitter {
    display: grid;
    gap: 1.25rem;
    grid-template-areas: 'tekst' 'form' 'tillid' 'foto';
  }
  .hero-tekst { grid-area: tekst; gap: 0.75rem; }
  .hero-form { grid-area: form; min-width: 0; }
  .hero-tillid { grid-area: tillid; }
  .hero-foto { grid-area: foto; margin: 0.75rem 0 0; display: grid; gap: 0.5rem; }
  .hero-eksempel { grid-area: eksempel; display: grid; justify-items: center; margin-top: 1.5rem; }
  .hero-gitter--eksempel { grid-template-areas: 'tekst' 'form' 'tillid' 'eksempel'; }
  .hero-foto img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--r-m);
  }
  .hero-foto figcaption {
    font-size: var(--t-xs);
    color: var(--skifer);
  }
  @media (min-width: 60rem) {
    .hero { padding-block: 3.5rem 4.5rem; }
    .hero-gitter {
      grid-template-columns: 1fr 30rem;
      grid-template-areas: 'tekst form' 'tillid form' 'foto form';
      grid-template-rows: auto auto 1fr;
      column-gap: 4rem;
      row-gap: 1.5rem;
      align-items: start;
    }
    /* Overskriften over hele bredden, derunder adressefeltet og et eksempel på, hvad man får */
    .hero-gitter--eksempel {
      grid-template-columns: minmax(0, 30rem) 1fr;
      grid-template-areas: 'tekst tekst' 'form eksempel' 'tillid eksempel';
      grid-template-rows: auto auto 1fr;
      row-gap: 2rem;
    }
    .hero-gitter--eksempel .hero-tekst { max-width: 50rem; }
    .h1-del { display: block; }
    .hero-eksempel { margin-top: 0; align-self: start; justify-items: center; }
  }
</style>
