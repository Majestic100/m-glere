---
const trin = [
  { t: 'Skriv din adresse', b: 'Vi henter boligtype og areal fra BBR og viser et vejledende prisinterval med det samme.' },
  { t: 'Vælg din mægler', b: 'Du ser de partnermæglere, der kender dit område. Med billede, video og tal for deres salg. Du vælger én.' },
  { t: 'Få en gratis vurdering', b: 'Vi ringer kort til dig, og derefter ringer mægleren og aftaler en salgsvurdering. Kun den mægler, du har valgt.' },
];
---
<ol class="svd">
  {trin.map((x, i) => (
    <li>
      <span class="svd-nr" aria-hidden="true">{i + 1}</span>
      <div class="stak svd-tekst">
        <h3>{x.t}</h3>
        <p>{x.b}</p>
      </div>
    </li>
  ))}
</ol>
<style>
  .svd {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.75rem;
  }
  .svd li {
    display: grid;
    grid-template-columns: 2.75rem 1fr;
    gap: 1rem;
    align-items: start;
  }
  .svd-nr {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--lyng);
    color: var(--paa-lyng);
    font-weight: 750;
    font-size: var(--t-l);
  }
  .svd-tekst {
    gap: 0.35rem;
    min-width: 0;
  }
  .svd-tekst p {
    color: var(--skifer);
  }
  @media (min-width: 60rem) {
    .svd {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
    .svd li {
      grid-template-columns: 1fr;
    }
  }
</style>
