---
// Viser, hvad boligejeren får, før de går i gang. Tallene er et tydeligt mærket eksempel, ikke en rigtig bolig,
// og mægleren er anonym, så vi aldrig viser et opfundet navn.
---
<figure class="eks" aria-label="Eksempel på et resultat">
  <div class="eks-kort eks-estimat">
    <div class="eks-hoved">
      <span class="eks-bolig">Villa, 140 m²</span>
      <span class="eks-maerke">Eksempel</span>
    </div>
    <p class="eks-label">Dit estimat</p>
    <p class="eks-tal tal">2,9 til 3,3 mio. kr.</p>
    <div class="eks-skala" aria-hidden="true"><span></span></div>
    <p class="eks-note">Et interval ud fra handler i området</p>
  </div>
  <div class="eks-kort eks-maegler">
    <p class="eks-label">Din anbefalede mægler</p>
    <div class="eks-person">
      <span class="eks-avatar" aria-hidden="true">
        <svg viewBox="0 0 40 40" width="40" height="40"><circle cx="20" cy="15" r="7"></circle><path d="M6 37c1.5-8 7-12 14-12s12.5 4 14 12z"></path></svg>
      </span>
      <span class="eks-navn">Lokal mægler i dit område</span>
    </div>
    <ul class="eks-grunde">
      <li>Sælger boliger som din i nærheden</li>
      <li>Kender prisniveauet i dit område</li>
      <li>Kun denne mægler kontakter dig</li>
    </ul>
  </div>
  <figcaption class="sr-only">Eksempel. Dit eget resultat afhænger af din bolig og dit område.</figcaption>
</figure>
<style>
  .eks {
    margin: 0;
    display: grid;
    gap: 0.75rem;
    max-width: 26rem;
    width: 100%;
  }
  .eks-kort {
    background: var(--flade);
    border: 1px solid var(--streg);
    border-radius: 18px;
    padding: 1.25rem;
    box-shadow: var(--skygge);
  }
  .eks-hoved {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.9rem;
  }
  .eks-bolig {
    font-size: var(--t-s);
    font-weight: 600;
  }
  .eks-maerke {
    font-size: var(--t-xs);
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: var(--rav-tone);
    color: var(--paa-rav-tone);
  }
  .eks-label {
    margin: 0;
    font-size: var(--t-xs);
    font-weight: 600;
    color: var(--skifer);
  }
  .eks-tal {
    margin: 0.15rem 0 0.75rem;
    font-size: clamp(1.375rem, 1.2rem + 0.7vw, 1.75rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--gron);
  }
  /* Intervallet som et bånd, hvor middelværdien er markeret */
  .eks-skala {
    position: relative;
    height: 10px;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--gron-tone) 0 18%, var(--gron) 18% 82%, var(--gron-tone) 82%);
  }
  .eks-skala span {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 20px;
    height: 20px;
    margin: -10px 0 0 -10px;
    border-radius: 50%;
    background: var(--rav);
    border: 3px solid var(--flade);
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.2);
  }
  .eks-note {
    margin: 0.6rem 0 0;
    font-size: var(--t-xs);
    color: var(--skifer);
  }
  .eks-maegler {
    display: grid;
    gap: 0.75rem;
  }
  .eks-person {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .eks-avatar {
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--gron-tone);
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .eks-avatar svg {
    fill: var(--gron);
    opacity: 0.55;
    margin-top: 6px;
  }
  .eks-navn {
    font-weight: 700;
  }
  .eks-grunde {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
    font-size: var(--t-s);
  }
  .eks-grunde li {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
  }
  .eks-grunde li::before {
    content: '';
    flex: none;
    width: 0.55rem;
    height: 0.3rem;
    border-left: 2px solid var(--ok);
    border-bottom: 2px solid var(--ok);
    transform: translateY(-0.2rem) rotate(-45deg);
  }
  @media (min-width: 60rem) {
    .eks {
      gap: 0;
      max-width: 27rem;
    }
    /* Kortene ligger forskudt oven på hinanden, som to skærme i flowet */
    .eks-estimat {
      margin-right: 3rem;
      position: relative;
      z-index: 1;
    }
    .eks-maegler {
      margin: -1.25rem 0 0 3rem;
      padding-top: 2rem;
    }
  }
</style>
