---
// Vurderings-flowet. Én ting pr. skærm, progress bar, tilbage-knap på alle trin.
// Svarene gemmes løbende i sessionStorage, så intet går tabt ved et genindlæs.
import m2Prod from '../../data/m2-priser.json';
import m2Demo from '../../data/demo/m2-priser.json';
import estimatConfig from '../../config/estimat.json';
import matchConfig from '../../config/matching.json';
import maeglerData from '../../data/maeglere.json';
import site from '../../data/site.json';
import handlerData from '../../data/sammenlignelige-handler.json';
import { BOLIGTYPER, STAND, TILVALG, HORISONTER, medTal } from '../lib/faelles.js';

const DEMO = import.meta.env.PUBLIC_DEMO === '1';

// I produktion sker matchingen på serveren (/api/match). Mæglerdata bygges kun ind i demoen,
// hvor der ingen server er, så kapacitet, feedback og responstid ikke ligger i sidens kildekode.
const data = {
  demo: DEMO,
  m2: medTal(DEMO ? m2Demo : m2Prod),
  estimatConfig,
  maeglere: DEMO ? medTal(maeglerData).maeglere : null,
  matchConfig: DEMO ? matchConfig : null,
  samtykkeVersion: site.samtykkeVersion,
  handler: medTal(handlerData).handler,
  handlerKilde: handlerData.kilde,
  adressevaelgerToken: import.meta.env.PUBLIC_ADRESSEVAELGER_TOKEN || 'adressevaelger123',
};
const json = JSON.stringify(data).replace(/</g, '\\u003c');
---
<div class="vf-hus">
<svg class="vf-gavl" viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true" focusable="false"><polygon points="0,10 50,0.4 100,10"></polygon></svg>
<section class="vf" id="vurdering" aria-label="Se din boligværdi">
  <script type="application/json" id="vf-data" set:html={json} />
  <!-- Links, som flowet bruger i sine tekster. Ligger i HTML, så de kan omskrives i demo og preview. -->
  <a hidden id="vf-link-faq" href="/ofte-stillede-spoergsmaal#hvordan-finder-i-min-maegler">Sådan finder vi din mægler</a>
  <a hidden id="vf-link-pdp" href="/persondatapolitik">Persondatapolitik</a>

  <div class="vf-top" id="vf-top" hidden>
    <button type="button" class="vf-tilbage" id="vf-tilbage">
      <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M12.5 4 6.5 10l6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      Tilbage
    </button>
    <span class="vf-trin" id="vf-trin" aria-live="polite"></span>
  </div>
  <div class="vf-status" id="vf-status" role="progressbar" aria-label="Hvor langt du er" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" hidden>
    <span id="vf-status-fyld"></span>
  </div>

  <form id="vf-form" novalidate autocomplete="on">
    <!-- Trin 1: Adresse -->
    <div class="vf-skaerm" data-skaerm="adresse">
      <div class="felt vf-ac">
        <label for="vf-adresse">Din adresse</label>
        <div class="ac-boks">
          <input
            id="vf-adresse"
            name="adresse"
            type="text"
            inputmode="search"
            autocomplete="off"
            spellcheck="false"
            placeholder="Skriv din adresse, fx Søndergade 12, 8000 Aarhus C"
            role="combobox"
            aria-autocomplete="list"
            aria-expanded="false"
            aria-controls="vf-forslag"
            aria-describedby="vf-adresse-hjaelp vf-adresse-fejl"
          />
          <ul id="vf-forslag" role="listbox" aria-label="Adresseforslag" hidden></ul>
        </div>
        <p class="hjaelp" id="vf-adresse-hjaelp">Tager cirka 30 sekunder</p>
      </div>
      <div class="felt" id="vf-enhed-felt" hidden>
        <label for="vf-enhed">Etage og dør</label>
        <select id="vf-enhed" name="enhed"></select>
      </div>
      <div id="vf-manuel" class="stak" hidden>
        <p class="vf-note" id="vf-manuel-note">Skriv din adresse her i stedet.</p>
        <div class="felt">
          <label for="vf-vej">Vej, husnummer og evt. etage</label>
          <input id="vf-vej" name="vej" type="text" autocomplete="address-line1" aria-describedby="vf-adresse-fejl" />
        </div>
        <div class="felt felt--kort">
          <label for="vf-postnr">Postnummer</label>
          <input id="vf-postnr" name="postnr" type="text" inputmode="numeric" pattern="[0-9]{4}" maxlength="4" autocomplete="postal-code" aria-describedby="vf-adresse-fejl" />
        </div>
      </div>
      <p class="fejltekst" id="vf-adresse-fejl" role="alert" hidden></p>
      <button type="button" class="knap knap--fuld" data-naeste>Se min boligværdi</button>
      <button type="button" class="knap knap--link" id="vf-manuel-knap">Kan du ikke finde adressen?</button>
    </div>

    <!-- Trin 2: BBR-oplysninger -->
    <div class="vf-skaerm" data-skaerm="bolig" hidden>
      <h2 class="vf-h" tabindex="-1">Er oplysningerne rigtige?</h2>
      <p class="vf-note" id="vf-bbr-note">Offentlige registre er ikke altid opdaterede. Ret gerne det, der ikke passer.</p>
      <fieldset class="valg" aria-describedby="vf-bolig-fejl">
        <legend>Boligtype</legend>
        {BOLIGTYPER.map((b) => (
          <label class="valg-flise"><input type="radio" name="boligtype" value={b.id} /> <span>{b.navn}</span></label>
        ))}
      </fieldset>
      <div class="felter-raekke">
        <div class="felt">
          <label for="vf-areal">Boligareal</label>
          <div class="enhed-input"><input id="vf-areal" name="areal" type="text" inputmode="numeric" maxlength="4" aria-describedby="vf-bolig-fejl" /><span>m²</span></div>
        </div>
        <div class="felt">
          <label for="vf-vaerelser">Værelser</label>
          <input id="vf-vaerelser" name="vaerelser" type="text" inputmode="numeric" maxlength="2" aria-describedby="vf-bolig-fejl" />
        </div>
        <div class="felt">
          <label for="vf-byggeaar">Byggeår</label>
          <input id="vf-byggeaar" name="byggeaar" type="text" inputmode="numeric" maxlength="4" aria-describedby="vf-bolig-fejl" />
        </div>
      </div>
      <p class="fejltekst" id="vf-bolig-fejl" role="alert" hidden></p>
      <button type="button" class="knap knap--fuld" data-naeste>Ja, det passer</button>
    </div>

    <!-- Trin 3: Stand og tilvalg -->
    <div class="vf-skaerm" data-skaerm="stand" hidden>
      <h2 class="vf-h" tabindex="-1">Hvordan står det til med boligen?</h2>
      <fieldset class="valg">
        <legend>Indvendig stand</legend>
        <div class="segment">
          {STAND.map((s) => (
            <label class="valg-flise"><input type="radio" name="indvendig" value={s.id} /> <span>{s.navn}</span></label>
          ))}
        </div>
      </fieldset>
      <fieldset class="valg">
        <legend>Udvendig stand</legend>
        <div class="segment">
          {STAND.map((s) => (
            <label class="valg-flise"><input type="radio" name="udvendig" value={s.id} /> <span>{s.navn}</span></label>
          ))}
        </div>
      </fieldset>
      <fieldset class="valg">
        <legend>Har boligen noget af det her?</legend>
        {TILVALG.map((t) => (
          <label class="valg-flise"><input type="checkbox" name="tilvalg" value={t.id} /> <span>{t.navn}</span></label>
        ))}
      </fieldset>
      <button type="button" class="knap knap--fuld" data-naeste>Videre</button>
    </div>

    <!-- Trin 4: Salgshorisont -->
    <div class="vf-skaerm" data-skaerm="horisont" hidden>
      <fieldset class="valg">
        <legend class="vf-h" tabindex="-1">Hvornår overvejer du at sælge?</legend>
        {HORISONTER.map((h) => (
          <label class="valg-flise"><input type="radio" name="horisont" value={h.id} data-auto /> <span>{h.navn}</span></label>
        ))}
      </fieldset>
      <p class="fejltekst" id="vf-horisont-fejl" role="alert" hidden></p>
      <button type="button" class="knap knap--fuld" data-naeste>Se min boligværdi</button>
    </div>

    <!-- Trin 5 og 6: Geo-tjek og resultat -->
    <div class="vf-skaerm" data-skaerm="resultat" hidden>
      <div class="stak" id="vf-res-estimat">
        <p class="vf-adresse-linje" id="vf-res-adresse"></p>
        <h2 class="vf-h vf-h--stor" tabindex="-1" id="vf-res-titel"></h2>
        <p class="vf-middel" id="vf-res-middel"></p>
        <p class="vf-testdata" id="vf-testdata" hidden>Testtal. Ikke rigtige priser.</p>
        <div class="vf-praecision" id="vf-praecision"></div>
      </div>
      <div id="vf-res-detaljer" class="stak-l"></div>
      <p class="vf-aerlig">Et onlineestimat kender registrene, men ikke dit nye køkken. En lokal mægler kan give dig en præcis salgspris, gratis og uforpligtende. Du behøver ikke engang rydde op.</p>
      <div id="vf-res-maegler"></div>
      <div id="vf-res-foelg"></div>
    </div>

    <!-- Trin 7: Kontakt og samtykke -->
    <div class="vf-skaerm" data-skaerm="kontakt" hidden>
      <h2 class="vf-h" tabindex="-1" id="vf-kontakt-titel">Få en præcis vurdering</h2>
      <div class="vf-valgt" id="vf-valgt"></div>
      <div class="felter-raekke felter-raekke--2">
        <div class="felt">
          <label for="vf-fornavn">Fornavn</label>
          <input id="vf-fornavn" name="fornavn" type="text" autocomplete="given-name" aria-describedby="vf-kontakt-fejl" />
        </div>
        <div class="felt">
          <label for="vf-efternavn">Efternavn</label>
          <input id="vf-efternavn" name="efternavn" type="text" autocomplete="family-name" aria-describedby="vf-kontakt-fejl" />
        </div>
      </div>
      <div class="felt">
        <label for="vf-tlf">Telefon</label>
        <input id="vf-tlf" name="telefon" type="tel" inputmode="tel" autocomplete="tel-national" placeholder="8 cifre" aria-describedby="vf-tlf-hjaelp vf-kontakt-fejl" />
        <p class="hjaelp" id="vf-tlf-hjaelp">Til at bekræfte og aftale vurderingen med mægleren.</p>
      </div>
      <div class="felt">
        <label for="vf-email">E-mail</label>
        <input id="vf-email" name="email" type="email" inputmode="email" autocomplete="email" aria-describedby="vf-kontakt-fejl" />
      </div>
      <div class="samtykke-raekke">
        <label class="samtykke">
          <input type="checkbox" id="vf-samtykke" name="samtykke" aria-describedby="vf-kontakt-fejl" />
          <span id="vf-samtykke-tekst"></span>
        </label>
        <a class="samtykke-link" href="/persondatapolitik" target="_blank" rel="noopener">Persondatapolitik</a>
      </div>
      <label class="samtykke samtykke--frivillig">
        <input type="checkbox" id="vf-foelg" name="foelg" />
        <span id="vf-foelg-tekst"></span>
      </label>
      <div class="vf-honning" aria-hidden="true">
        <label for="vf-firma">Firma</label>
        <input id="vf-firma" name="firma" type="text" tabindex="-1" autocomplete="off" />
      </div>
      <p class="fejltekst" id="vf-kontakt-fejl" role="alert" hidden></p>
      <button type="submit" class="knap knap--fuld" id="vf-send">Send til mægleren</button>
    </div>

    <!-- Trin 8: Tak -->
    <div class="vf-skaerm" data-skaerm="tak" hidden>
      <div class="vf-tak stak" id="vf-tak"></div>
    </div>
  </form>
</section>
</div>

<script>
  import '../scripts/flow.js';
</script>

<style is:global>
  /* Formularen er tegnet som et hus: en gavl oven på kortet, ligesom taget i logoet. */
  .vf-hus {
    filter: drop-shadow(0 1px 1px rgb(26 34 31 / 0.07)) drop-shadow(0 12px 28px rgb(26 34 31 / 0.09));
  }
  .vf-gavl {
    display: block;
    width: 100%;
    height: clamp(22px, 7vw, 40px);
    margin-bottom: -1px;
  }
  .vf-gavl polygon {
    fill: var(--flade);
  }
  .vf {
    background: var(--flade);
    border-radius: 0 0 var(--r-m) var(--r-m);
    padding: 0.5rem 1.25rem 1.25rem;
    display: grid;
    gap: 1rem;
    scroll-margin-top: 1rem;
  }
  @media (min-width: 30rem) {
    .vf { padding: 0.75rem 1.75rem 1.75rem; }
  }
  .vf-skaerm {
    display: grid;
    gap: 1.1rem;
  }
  .vf-h {
    font-size: var(--t-trin);
    font-weight: 750;
    outline: none;
  }
  .vf-h--stor {
    font-size: var(--t-xl);
    line-height: 1.15;
  }
  .vf-adresse-linje {
    font-size: var(--t-s);
    font-weight: 600;
    color: var(--skifer);
  }
  .vf-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: -0.25rem 0 -0.5rem -0.5rem;
  }
  .vf-tilbage {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    min-height: 44px;
    padding: 0 0.5rem;
    border: 0;
    background: none;
    font: inherit;
    font-weight: 650;
    color: var(--gron);
    cursor: pointer;
  }
  .vf-trin {
    font-size: var(--t-s);
    color: var(--skifer);
  }
  .vf-status {
    height: 6px;
    border-radius: 3px;
    background: var(--gron-tone);
    overflow: hidden;
  }
  .vf-status span {
    display: block;
    height: 100%;
    width: 0;
    background: var(--gron);
    border-radius: 3px;
    transition: width 0.25s ease;
  }
  .felt {
    display: grid;
    gap: 0.4rem;
    position: relative;
    min-width: 0;
  }
  .felt label,
  .valg legend {
    font-weight: 650;
  }
  .felt input,
  .felt select {
    width: 100%;
    min-height: 56px;
    padding: 0 1rem;
    font: inherit;
    font-size: max(16px, var(--t-m));
    color: var(--blaek);
    background: var(--flade);
    border: 1.5px solid var(--felt-kant);
    border-radius: var(--r-s);
  }
  .felt input:focus,
  .felt select:focus {
    outline: 3px solid var(--gron-kant);
    outline-offset: 0;
    border-color: var(--gron);
  }
  .felt input[aria-invalid='true'] {
    border-color: var(--fejl);
  }
  .felt--kort {
    max-width: 12rem;
  }
  .felter-raekke {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
  }
  .felter-raekke--2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .ac-boks {
    position: relative;
  }
  .enhed-input {
    position: relative;
  }
  .enhed-input input {
    padding-right: 3rem;
  }
  .enhed-input span {
    position: absolute;
    right: 0.9rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--skifer);
    pointer-events: none;
  }
  .hjaelp,
  .vf-note {
    font-size: var(--t-s);
    color: var(--skifer);
  }
  .fejltekst {
    color: var(--fejl);
    font-weight: 600;
    font-size: var(--t-s);
  }
  #vf-forslag {
    list-style: none;
    margin: 0;
    padding: 0.25rem;
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    right: 0;
    z-index: 20;
    background: var(--flade);
    border: 1px solid var(--streg);
    border-radius: var(--r-s);
    box-shadow: var(--skygge);
    max-height: 18rem;
    overflow-y: auto;
  }
  #vf-forslag li {
    min-height: 48px;
    display: flex;
    align-items: center;
    padding: 0.5rem 0.75rem;
    border-radius: 6px;
    cursor: pointer;
  }
  #vf-forslag li[aria-selected='true'],
  #vf-forslag li:hover {
    background: var(--gron-tone);
  }
  .valg {
    border: 0;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
    min-width: 0;
  }
  .valg legend {
    padding: 0;
    margin-bottom: 0.6rem;
  }
  .valg legend.vf-h {
    margin-bottom: 0.9rem;
  }
  .segment {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
  }
  .segment .valg-flise {
    flex-direction: column;
    justify-content: center;
    text-align: center;
    gap: 0.4rem;
    padding: 0.6rem 0.4rem;
    font-size: var(--t-s);
    line-height: 1.25;
  }
  .valg-flise {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    min-height: 56px;
    padding: 0.6rem 1rem;
    background: var(--flade);
    border: 1.5px solid var(--streg);
    border-radius: var(--r-s);
    cursor: pointer;
    font-weight: 550;
  }
  .valg-flise:has(input:checked) {
    border-color: var(--gron);
    background: var(--gron-tone);
  }
  .valg-flise:has(input:focus-visible) {
    outline: 3px solid var(--gron);
    outline-offset: 2px;
  }
  .valg-flise input,
  .samtykke input {
    flex: none;
    width: 22px;
    height: 22px;
    margin: 0;
    accent-color: var(--gron);
  }
  .vf-middel {
    font-weight: 650;
    color: var(--gron);
  }
  .vf-testdata {
    justify-self: start;
    background: var(--ph-bg);
    color: var(--ph-fg);
    border-radius: 4px;
    padding: 0.2rem 0.5rem;
    font-weight: 650;
    font-size: var(--t-s);
  }
  .vf-praecision {
    display: grid;
    gap: 0.4rem;
    font-size: var(--t-s);
    color: var(--skifer);
  }
  .praecision-chip {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    color: var(--blaek);
  }
  .praecision-chip i {
    display: inline-flex;
    gap: 3px;
  }
  .praecision-chip i b {
    width: 14px;
    height: 8px;
    border-radius: 2px;
    background: var(--streg);
  }
  .praecision-chip i b.til {
    background: var(--gron);
  }
  .vf-aerlig {
    padding: 1rem;
    background: var(--kalk);
    border-radius: var(--r-s);
    font-size: var(--t-s);
  }
  .samtykke-raekke {
    display: grid;
    gap: 0.4rem;
  }
  .samtykke-link {
    justify-self: start;
    font-size: var(--t-s);
    min-height: 32px;
    display: inline-flex;
    align-items: center;
  }
  .samtykke {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
    padding: 1rem;
    border: 1.5px solid var(--streg);
    border-radius: var(--r-s);
    background: var(--flade);
    cursor: pointer;
    font-size: var(--t-s);
    line-height: 1.5;
  }
  .samtykke input {
    margin-top: 0.1rem;
  }
  .samtykke:has(input:checked) {
    border-color: var(--gron);
  }
  .samtykke--frivillig {
    border-style: dashed;
  }
  .vf-valgt {
    display: flex;
    gap: 0.85rem;
    align-items: center;
  }
  .vf-honning {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .vf-tak h2 {
    font-size: var(--t-xl);
  }
  .vf-preview {
    background: var(--ph-bg);
    color: var(--ph-fg);
    padding: 0.75rem 1rem;
    border-radius: var(--r-s);
    font-size: var(--t-s);
    font-weight: 600;
  }
  /* Kortet med den anbefalede mægler */
  .anbefalet {
    display: grid;
    gap: 1rem;
    padding: 1.25rem;
    border: 1.5px solid var(--gron);
    border-radius: var(--r-m);
    background: var(--flade);
  }
  .anbefalet-hoved {
    display: flex;
    gap: 0.9rem;
    align-items: center;
  }
  .anbefalet ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.5rem;
  }
  .anbefalet li {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    font-size: var(--t-s);
  }
  .anbefalet li svg {
    flex: none;
    margin-top: 0.15em;
  }
  .mk-foto {
    flex: none;
    width: 72px;
    height: 72px;
    border-radius: 12px;
    object-fit: cover;
    background: var(--gron-tone);
  }
  .mk-foto--ph {
    display: grid;
    place-items: center;
    text-align: center;
    background: var(--ph-bg);
    color: var(--ph-fg);
    font-size: 0.7rem;
    font-weight: 700;
    line-height: 1.2;
    padding: 0.25rem;
  }
  .mk-navn {
    font-weight: 750;
    line-height: 1.25;
  }
  .mk-firma {
    font-size: var(--t-s);
    color: var(--skifer);
  }
  .noegletal {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem;
    margin: 0;
  }
  .noegletal div {
    padding: 0.75rem;
    border: 1px solid var(--streg);
    border-radius: var(--r-s);
    min-width: 0;
  }
  .noegletal dt {
    font-size: var(--t-xs);
    color: var(--skifer);
  }
  .noegletal dd {
    margin: 0;
    font-weight: 750;
    font-size: var(--t-l);
