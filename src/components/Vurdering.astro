---
// Formularen i trin. Én ting pr. skærm. Mæglere og kvadratmeterpriser bygges ind i siden som JSON.
import maeglerData from '../data/maeglere.json';
import kvmpriser from '../data/kvmpriser.json';
import site from '../data/site.json';
import { BOLIGTYPER, TIDSHORISONTER, PRIORITETER, TIDSPUNKTER } from '../lib/vurdo.js';


const offentligeFelter = ['id', 'navn', 'titel', 'butik', 'omraade', 'postnumre', 'billede', 'video', 'videoPoster', 'beskrivelse', 'solgte', 'solgtePeriode', 'solgteKilde', 'bedoemmelse', 'bedoemmelseAntal', 'bedoemmelseKilde', 'pladsholder'];
const maeglere = maeglerData.maeglere
  .filter((m) => m.aktiv !== false)
  .map((m) => Object.fromEntries(offentligeFelter.map((f) => [f, (m as Record<string, unknown>)[f]])));

// CMS'et gemmer priserne som en liste. Formularen slår op på postnummer.
// Kun tallene og testflaget sendes med. Kilde og noter bliver i CMS'et.
const { priser, pladsholder } = kvmpriser;
const data = {
  maeglere,
  kvmpriser: {
    pladsholder,
    postnumre: Object.fromEntries(
      priser.map(({ postnr, ...typer }) => [postnr, Object.fromEntries(Object.entries(typer).filter(([, v]) => Number(v) > 0))]),
    ),
  },
  estimat: site.estimat,
  beregner: site.beregner,
  aabningstider: site.aabningstider,
  samtykkeVersion: site.samtykkeVersion,
  adressevaelgerToken: import.meta.env.PUBLIC_ADRESSEVAELGER_TOKEN || 'adressevaelger123',
};
const json = JSON.stringify(data).replace(/</g, '\\u003c');
---
<div class="vf-hus">
<svg class="vf-gavl" viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true" focusable="false"><polygon points="0,10 50,0.4 100,10"></polygon></svg>
<section class="vf" id="vurdering" aria-labelledby="vf-titel">
  <script type="application/json" id="vf-data" set:html={json} />

  <div class="vf-top" id="vf-top" hidden>
    <button type="button" class="vf-tilbage" id="vf-tilbage">
      <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><path d="M12.5 4 6.5 10l6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      Tilbage
    </button>
    <span class="vf-trin tal" id="vf-trin" aria-live="polite"></span>
  </div>
  <div class="vf-status" id="vf-status" role="progressbar" aria-label="Hvor langt du er" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" hidden>
    <span id="vf-status-fyld"></span>
  </div>

  <form id="vf-form" novalidate autocomplete="on">
    <!-- 1a. Adresse -->
    <div class="vf-skaerm" data-skaerm="adresse">
      <h2 class="vf-h" id="vf-titel" tabindex="-1">Start med din adresse</h2>
      <div class="felt vf-ac">
        <label for="vf-adresse">Din adresse</label>
        <div class="ac-boks">
        <input
          id="vf-adresse"
          name="adresse"
          type="text"
          inputmode="search"
          autocomplete="off"
          spellcheck="false"
          placeholder="Fx Søndergade 12, 8000 Aarhus C"
          role="combobox"
          aria-autocomplete="list"
          aria-expanded="false"
          aria-controls="vf-forslag"
          aria-describedby="vf-adresse-hjaelp vf-adresse-fejl"
        />
        <ul id="vf-forslag" role="listbox" aria-label="Adresseforslag" hidden></ul>
        </div>
        <p class="hjaelp" id="vf-adresse-hjaelp">Skriv vejnavn og husnummer, og vælg din adresse på listen.</p>
      </div>
      <div class="felt" id="vf-enhed-felt" hidden>
        <label for="vf-enhed">Etage og dør</label>
        <select id="vf-enhed" name="enhed"></select>
      </div>
      <div id="vf-manuel" class="stak" hidden>
        <p class="vf-note" id="vf-manuel-note">Skriv din adresse her i stedet.</p>
        <div class="felt">
          <label for="vf-vej">Vej, husnummer og evt. etage</label>
          <input id="vf-vej" name="vej" type="text" autocomplete="address-line1" aria-describedby="vf-adresse-fejl" />
        </div>
        <div class="felt felt--kort">
          <label for="vf-postnr">Postnummer</label>
          <input id="vf-postnr" name="postnr" type="text" inputmode="numeric" pattern="[0-9]{4}" maxlength="4" autocomplete="postal-code" aria-describedby="vf-adresse-fejl" />
        </div>
      </div>
      <p class="fejltekst" id="vf-adresse-fejl" role="alert" hidden></p>
      <button type="button" class="knap knap--fuld" data-naeste>Se hvad din bolig er værd</button>
      <button type="button" class="knap knap--link" id="vf-manuel-knap">Kan du ikke finde adressen?</button>
    </div>

    <!-- 1b. Bekræft boligtype og areal -->
    <div class="vf-skaerm" data-skaerm="bolig" hidden>
      <h2 class="vf-h" tabindex="-1">Passer det her?</h2>
      <p class="vf-note" id="vf-bbr-note">Vi henter oplysninger om din bolig.</p>
      <fieldset class="valg" aria-describedby="vf-bolig-fejl">
        <legend>Boligtype</legend>
        {BOLIGTYPER.map((b) => (
          <label class="valg-flise"><input type="radio" name="boligtype" value={b.id} /> <span>{b.navn}</span></label>
        ))}
      </fieldset>
      <div class="felt felt--kort">
        <label for="vf-areal">Boligareal</label>
        <div class="enhed-input"><input id="vf-areal" name="areal" type="text" inputmode="numeric" maxlength="4" aria-describedby="vf-bolig-fejl" /><span>m²</span></div>
      </div>
      <p class="fejltekst" id="vf-bolig-fejl" role="alert" hidden></p>
      <button type="button" class="knap knap--fuld" data-naeste>Se estimat</button>
    </div>

    <!-- 2. Estimat -->
    <div class="vf-skaerm" data-skaerm="estimat" hidden>
      <div id="vf-estimat-ok" class="stak">
        <p class="vf-adresse-linje" id="vf-estimat-adresse"></p>
        <h2 class="vf-h" tabindex="-1">Din bolig er cirka værd</h2>
        <p class="vf-interval tal" id="vf-interval"></p>
        <p class="vf-testdata" id="vf-testdata" hidden>Testtal. Ikke rigtige priser endnu.</p>
        <div class="vf-forbehold">
          <p><strong>Et vejledende interval.</strong> En lokal mægler kan give dig en præcis vurdering, når de har set din bolig.</p>
        </div>
      </div>
      <div id="vf-estimat-mangler" class="stak" hidden>
        <h2 class="vf-h" tabindex="-1">Vi kan ikke give et estimat her</h2>
        <p id="vf-estimat-mangler-tekst"></p>
      </div>
      <button type="button" class="knap knap--fuld" data-naeste id="vf-til-provenu">Hvad står jeg tilbage med?</button>
      <button type="button" class="knap knap--link" data-spring="tid" id="vf-spring-provenu">Spring over</button>
    </div>

    <!-- 3. Provenu -->
    <div class="vf-skaerm" data-skaerm="provenu" hidden>
      <h2 class="vf-h" tabindex="-1">Hvad står du tilbage med?</h2>
      <p class="vf-note">Valgfrit. Tallene bliver ikke sendt til nogen, før du selv sender formularen.</p>
      <div class="felt">
        <label for="vf-pris">Forventet salgspris</label>
        <div class="enhed-input"><input id="vf-pris" name="salgspris" type="text" inputmode="numeric" /><span>kr.</span></div>
      </div>
      <div class="felt">
        <label for="vf-gaeld">Restgæld på dine lån</label>
        <div class="enhed-input"><input id="vf-gaeld" name="restgaeld" type="text" inputmode="numeric" placeholder="0" /><span>kr.</span></div>
        <p class="hjaelp">Du kan se den i din netbank eller hos dit realkreditinstitut.</p>
      </div>
      <div class="felt">
        <label for="vf-omk">Salær og andre salgsomkostninger</label>
        <div class="enhed-input"><input id="vf-omk" name="omkostninger" type="text" inputmode="numeric" /><span>kr.</span></div>
        <p class="hjaelp">Et groft bud. Spørg mægleren om den præcise pris.<span id="vf-omk-ph" hidden> <mark class="ph">[PLADSHOLDER: standardtal skal fastsættes]</mark></span></p>
      </div>
      <div class="vf-resultat" aria-live="polite">
        <span>Du står tilbage med cirka</span>
        <strong class="tal" id="vf-provenu">0 kr.</strong>
      </div>
      <p class="hjaelp">Regnestykket tager ikke højde for kurstab ved indfrielse af lån, skat eller andre udgifter ved flytning.</p>
      <button type="button" class="knap knap--fuld" data-naeste>Videre</button>
    </div>

    <!-- 4. Tidshorisont -->
    <div class="vf-skaerm" data-skaerm="tid" hidden>
      <fieldset class="valg">
        <legend class="vf-h" tabindex="-1">Hvornår overvejer du at sælge?</legend>
        {TIDSHORISONTER.map((t) => (
          <label class="valg-flise"><input type="radio" name="tidshorisont" value={t.id} data-auto /> <span>{t.navn}</span></label>
        ))}
      </fieldset>
      <button type="button" class="knap knap--fuld" data-naeste>Videre</button>
    </div>

    <!-- 4b. Kun for nysgerrige og områder uden partnermægler -->
    <div class="vf-skaerm" data-skaerm="tilbud" hidden>
      <h2 class="vf-h" tabindex="-1" id="vf-tilbud-titel">Vil du følge med i, hvad din bolig er værd?</h2>
      <p id="vf-tilbud-tekst">Vi kan sende dig en opdateret vurdering hver 3. måned. Det er gratis, og ingen mægler ringer til dig.</p>
      <button type="button" class="knap knap--fuld" data-naeste>Ja tak</button>
      <button type="button" class="knap knap--link" data-afslut>Nej tak, jeg ville bare se tallet</button>
    </div>

    <!-- 5. Prioriteter -->
    <div class="vf-skaerm" data-skaerm="prio" hidden>
      <fieldset class="valg">
        <legend class="vf-h" tabindex="-1">Hvad er vigtigst for dig?</legend>
        <p class="vf-note">Vælg gerne flere.</p>
        {PRIORITETER.map((p) => (
          <label class="valg-flise valg-flise--check"><input type="checkbox" name="prioriteter" value={p.id} /> <span>{p.navn}</span></label>
        ))}
      </fieldset>
      <button type="button" class="knap knap--fuld" data-naeste>Videre</button>
    </div>

    <!-- 6. Vælg mægler -->
    <div class="vf-skaerm" data-skaerm="maegler" hidden>
      <h2 class="vf-h" tabindex="-1">Vælg din mægler</h2>
      <p class="vf-note" id="vf-maegler-note"></p>
      <div class="vf-maeglere" id="vf-maeglere" role="radiogroup" aria-label="Partnermæglere"></div>
      <p class="fejltekst" id="vf-maegler-fejl" role="alert" hidden>Vælg den mægler, du gerne vil kontaktes af.</p>
    </div>

    <!-- 7. Kontakt -->
    <div class="vf-skaerm" data-skaerm="kontakt" hidden>
      <h2 class="vf-h" tabindex="-1" id="vf-kontakt-titel">Hvordan får vi fat i dig?</h2>
      <div class="felt">
        <label for="vf-navn">Navn</label>
        <input id="vf-navn" name="navn" type="text" autocomplete="name" aria-describedby="vf-kontakt-fejl" />
      </div>
      <div class="felt" id="vf-tlf-felt">
        <label for="vf-tlf">Telefon <span class="valgfri" id="vf-tlf-valgfri" hidden>(valgfri)</span></label>
        <input id="vf-tlf" name="telefon" type="tel" inputmode="tel" autocomplete="tel" aria-describedby="vf-kontakt-fejl" />
      </div>
      <div class="felt">
        <label for="vf-email">E-mail</label>
        <input id="vf-email" name="email" type="email" inputmode="email" autocomplete="email" aria-describedby="vf-kontakt-fejl" />
      </div>
      <fieldset class="valg valg--kompakt" id="vf-tidspunkt-felt">
        <legend>Hvornår passer det bedst, at vi ringer?</legend>
        {TIDSPUNKTER.map((t, i) => (
          <label class="valg-flise"><input type="radio" name="tidspunkt" value={t.id} checked={i === 0} /> <span>{t.navn}</span></label>
        ))}
      </fieldset>
      <div class="vf-honning" aria-hidden="true">
        <label for="vf-firma">Firma</label>
        <input id="vf-firma" name="firma" type="text" tabindex="-1" autocomplete="off" />
      </div>
      <p class="fejltekst" id="vf-kontakt-fejl" role="alert" hidden></p>
      <button type="button" class="knap knap--fuld" data-naeste>Videre</button>
    </div>

    <!-- 8. Samtykke -->
    <div class="vf-skaerm" data-skaerm="samtykke" hidden>
      <h2 class="vf-h" tabindex="-1" id="vf-samtykke-titel">Sidste trin</h2>
      <div class="vf-valgt" id="vf-valgt"></div>
      <label class="samtykke" id="vf-samtykke-1-felt">
        <input type="checkbox" id="vf-samtykke-1" name="samtykke_kontakt" aria-describedby="vf-samtykke-fejl" />
        <span id="vf-samtykke-1-tekst"></span>
      </label>
      <label class="samtykke" id="vf-samtykke-2-felt">
        <input type="checkbox" id="vf-samtykke-2" name="samtykke_kvartal" />
        <span id="vf-samtykke-2-tekst"></span>
      </label>
      <p class="hjaelp">Læs hvordan vi behandler dine oplysninger i vores <a href="/privatlivspolitik" target="_blank" rel="noopener">privatlivspolitik</a>.</p>
      <p class="fejltekst" id="vf-samtykke-fejl" role="alert" hidden></p>
      <button type="submit" class="knap knap--fuld" id="vf-send">Send</button>
    </div>

    <!-- Tak -->
    <div class="vf-skaerm" data-skaerm="tak" hidden>
      <div class="vf-tak stak" id="vf-tak"></div>
    </div>
  </form>
</section>
</div>

<script>
  import '../scripts/vurdering.js';
</script>

<style is:global>
  /* Formularen er tegnet som et hus: en gavl oven på kortet, ligesom taget i logoet.
     Skyggen ligger på hele huset, så gavl og kort står som én form. */
  .vf-hus {
    filter: drop-shadow(0 1px 1px rgb(26 34 31 / 0.07)) drop-shadow(0 12px 28px rgb(26 34 31 / 0.09));
  }
  .vf-gavl {
    display: block;
    width: 100%;
    height: clamp(26px, 9vw, 44px);
    margin-bottom: -1px;
  }
  .vf-gavl polygon {
    fill: var(--flade);
  }
  .vf {
    background: var(--flade);
    border-radius: 0 0 var(--r-m) var(--r-m);
    padding: 0.75rem 1.25rem 1.5rem;
    display: grid;
    gap: 1rem;
    scroll-margin-top: 1rem;
  }
  @media (min-width: 30rem) {
    .vf { padding: 0.75rem 1.75rem 1.75rem; }
  }
  .vf-adresse-linje {
    font-size: var(--t-s);
    font-weight: 600;
    color: var(--skifer);
  }
  .vf-skaerm {
    display: grid;
    gap: 1.1rem;
  }
  .vf-h {
    font-size: var(--t-l);
    font-weight: 700;
    outline: none;
  }
  .vf-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: -0.5rem 0 -0.5rem -0.5rem;
  }
  .vf-tilbage {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    min-height: 44px;
    padding: 0 0.5rem;
    border: 0;
    background: none;
    font: inherit;
    font-weight: 600;
    color: var(--gron);
    cursor: pointer;
  }
  .vf-trin {
    font-size: var(--t-s);
    color: var(--skifer);
  }
  .vf-status {
    height: 6px;
    border-radius: 3px;
    background: var(--gron-tone);
    overflow: hidden;
  }
  .vf-status span {
    display: block;
    height: 100%;
    width: 0;
    background: var(--gron);
    border-radius: 3px;
    transition: width 0.25s ease;
  }
  .felt {
    display: grid;
    gap: 0.4rem;
    position: relative;
  }
  .felt label,
  .valg legend {
    font-weight: 650;
  }
  .felt input,
  .felt select {
    width: 100%;
    min-height: 56px;
    padding: 0 1rem;
    font: inherit;
    font-size: max(16px, var(--t-m));
    color: var(--blaek);
    background: var(--flade);
    border: 1.5px solid var(--felt-kant);
    border-radius: var(--r-s);
  }
  .felt input:focus,
  .felt select:focus {
    outline: 3px solid var(--gron-kant);
    outline-offset: 0;
    border-color: var(--gron);
  }
  .felt input[aria-invalid='true'] {
    border-color: var(--fejl);
  }
  .felt--kort {
    max-width: 12rem;
  }
  .ac-boks {
    position: relative;
  }
  .enhed-input {
    position: relative;
  }
  .enhed-input input {
    padding-right: 3.5rem;
  }
  .enhed-input span {
    position: absolute;
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--skifer);
    pointer-events: none;
  }
  .hjaelp,
  .vf-note {
    font-size: var(--t-s);
    color: var(--skifer);
  }
  .valgfri {
    font-weight: 400;
    color: var(--skifer);
  }
  .fejltekst {
    color: var(--fejl);
    font-weight: 600;
    font-size: var(--t-s);
  }
  #vf-forslag {
    list-style: none;
    margin: 0;
    padding: 0.25rem;
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    right: 0;
    z-index: 20;
    background: var(--flade);
    border: 1px solid var(--streg);
    border-radius: var(--r-s);
    box-shadow: var(--skygge);
    max-height: 18rem;
    overflow-y: auto;
  }
  #vf-forslag li {
    min-height: 48px;
    display: flex;
    align-items: center;
    padding: 0.5rem 0.75rem;
    border-radius: 6px;
    cursor: pointer;
  }
  #vf-forslag li[aria-selected='true'],
  #vf-forslag li:hover {
    background: var(--gron-tone);
  }
  .valg {
    border: 0;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .valg legend {
    padding: 0;
    margin-bottom: 0.6rem;
  }
  .valg legend.vf-h {
    margin-bottom: 0.9rem;
  }
  .valg-flise {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    min-height: 56px;
    padding: 0.6rem 1rem;
    background: var(--flade);
    border: 1.5px solid var(--streg);
    border-radius: var(--r-s);
    cursor: pointer;
    font-weight: 550;
  }
  .valg-flise:has(input:checked) {
    border-color: var(--gron);
    background: var(--gron-tone);
  }
  .valg-flise input,
  .samtykke input {
    flex: none;
    width: 22px;
    height: 22px;
    margin: 0;
    accent-color: var(--gron);
  }
  .valg--kompakt .valg-flise {
    min-height: 48px;
  }
  .vf-interval {
    font-size: clamp(1.75rem, 1.3rem + 2.2vw, 2.4rem);
    font-weight: 750;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--gron);
  }
  .vf-testdata {
    justify-self: start;
    background: var(--ph-bg);
    color: var(--ph-fg);
    border-radius: 4px;
    padding: 0.2rem 0.5rem;
    font-weight: 650;
    font-size: var(--t-s);
  }
  .vf-forbehold {
    display: grid;
    gap: 0.5rem;
    padding: 1rem;
    background: var(--kalk);
    border-radius: var(--r-s);
    font-size: var(--t-s);
    color: var(--skifer);
  }
  .vf-forbehold strong {
    color: var(--blaek);
  }
  .vf-resultat {
    display: grid;
    gap: 0.25rem;
    padding: 1rem;
    background: var(--gron-tone);
    border-radius: var(--r-s);
  }
  .vf-resultat strong {
    font-size: var(--t-xl);
    color: var(--gron);
  }
  .vf-maeglere {
    display: grid;
    gap: 1rem;
  }
  .samtykke {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
    padding: 1rem;
    border: 1.5px solid var(--streg);
    border-radius: var(--r-s);
    background: var(--flade);
    cursor: pointer;
    font-size: var(--t-s);
    line-height: 1.5;
  }
  .samtykke input {
    margin-top: 0.1rem;
  }
  .samtykke:has(input:checked) {
    border-color: var(--gron);
  }
  .vf-valgt {
    display: flex;
    gap: 0.85rem;
    align-items: center;
  }
  .vf-honning {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .vf-tak h2 {
    font-size: var(--t-xl);
  }
  .vf-tak ol {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.9rem;
    counter-reset: trin;
  }
  .vf-tak li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.75rem;
    counter-increment: trin;
  }
  .vf-tak li::before {
    content: counter(trin);
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--gron-tone);
    color: var(--gron);
    font-weight: 700;
  }
  .vf-preview {
    background: var(--ph-bg);
    color: var(--ph-fg);
    padding: 0.75rem 1rem;
    border-radius: var(--r-s);
    font-size: var(--t-s);
    font-weight: 600;
  }
</style>
