# Kopier til Netlify > Site configuration > Environment variables.

# GoHighLevel: inbound webhook-URL fra en workflow med trigger "Inbound Webhook"
GHL_WEBHOOK_URL=

# Datafordeleren: API-nøgle til BBR GraphQL (opret IT-system i Datafordelerens administration)
DATAFORDELER_API_KEY=

# Meta Conversions API (valgfri). Pixel-ID bruges også i browseren via PUBLIC_META_PIXEL_ID.
META_PIXEL_ID=
META_CAPI_TOKEN=
# Sæt til en testkode fra Events Manager under test, ellers tom
META_TEST_EVENT_CODE=

# Browser-side (bygges ind i siden)
PUBLIC_META_PIXEL_ID=
# Adressevælger-token. "adressevaelger123" er Klimadatastyrelsens offentlige token.
PUBLIC_ADRESSEVAELGER_TOKEN=adressevaelger123
